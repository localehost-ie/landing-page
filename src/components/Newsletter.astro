---

---

<section class="bg-neutral py-20 md:py-24" id="newsletter">
	<div class="wrap grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
		<div class="text-neutral-content">
			<h2
				class="mt-4 max-w-xl text-3xl font-semibold text-base-100 md:text-4xl"
			>
				Be first through the door when we open bookings.
			</h2>

			<p class="mt-5 max-w-[440px] text-[15px] text-base-300">
				The full platform will be <span class="text-teal-bright"
					>launching soon</span
				>. Join the list and we'll email you the day it's live. Hosts
				and guests get slightly different updates, so tell us which you
				are.
			</p>
		</div>

		<div class="rounded-box border border-white/10 bg-[#1e2040] p-6 sm:p-7">
			<div
				class="tabs tabs-box bg-[#14152A] p-1"
				role="tablist"
				aria-label="I am a"
			>
				<button
					type="button"
					class="tab tab-active flex-1 text-xs font-semibold !text-[#14152A] sm:text-sm"
					role="tab"
					aria-selected="true"
					data-audience="guest"
				>
					Looking for a room
				</button>

				<button
					type="button"
					class="tab flex-1 text-xs font-semibold !text-[#9395AA] sm:text-sm"
					role="tab"
					aria-selected="false"
					data-audience="host"
				>
					Hosting a room
				</button>
			</div>

			<form id="newsletter-form" class="mt-5">
				<input
					type="hidden"
					name="audience"
					id="audience-field"
					value="guest"
				/>

				<label for="email" class="sr-only">Email address</label>

				<div class="flex flex-col gap-3 sm:flex-row">
					<input
						type="email"
						id="email"
						name="email"
						required
						placeholder="you@email.com"
						autocomplete="email"
						class="input input-bordered min-w-0 flex-1 rounded-full border-[#34365c] bg-[#14152a] text-sm text-base-100 placeholder:text-[#6c6e8a] focus:border-teal-bright"
					/>

					<button
						type="submit"
						class="btn btn-primary shrink-0 rounded-full"
						id="submit-btn"
					>
						<span class="btn-label">Notify me</span>
					</button>
				</div>

				<label
					class="mt-4 flex items-start gap-2 text-xs text-[#9395AA]"
				>
					<input
						type="checkbox"
						name="consent"
						id="newsletter-consent"
						required
						class="checkbox checkbox-sm checkbox-primary"
					/>
					<span>
						I agree to receive LocaleHost launch announcements and
						occasional updates. I can unsubscribe at any time.
					</span>
				</label>

				<p
					class="mt-4 text-xs text-[#7c7ea0]"
					id="form-note"
					aria-live="polite"
				>
					No spam. Just a launch email and the occasional update.
					Unsubscribe any time.
				</p>
			</form>
		</div>
	</div>
</section>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>(
		".tab[data-audience]",
	);
	const audienceField =
		document.querySelector<HTMLInputElement>("#audience-field")!;
	const form = document.querySelector<HTMLFormElement>("#newsletter-form")!;
	const note = document.querySelector<HTMLParagraphElement>("#form-note")!;
	const submitBtn = document.querySelector<HTMLButtonElement>("#submit-btn")!;

	const defaultNote =
		"No spam. Just a launch email and the occasional update. Unsubscribe any time.";

	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			tabs.forEach((t) => {
				t.classList.remove("tab-active");
				t.classList.remove("!text-[#14152A]");
				t.classList.add("!text-[#9395AA]");
				t.setAttribute("aria-selected", "false");
			});

			tab.classList.add("tab-active");
			tab.classList.remove("!text-[#9395AA]");
			tab.classList.add("!text-[#14152A]");
			tab.setAttribute("aria-selected", "true");

			audienceField.value = tab.dataset.audience ?? "guest";
		});
	});

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		if (!form.reportValidity()) return;

		const email = form.querySelector<HTMLInputElement>("#email")!;

		submitBtn.disabled = true;
		note.textContent = "Adding you to the list…";
		note.className = "mt-4 text-xs text-base-300";

		try {
			const response = await fetch("/api/newsletter", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify({
					email: email.value,
					audience: audienceField.value,
					consent:
						form.querySelector<HTMLInputElement>(
							"#newsletter-consent",
						)?.checked === true,
				}),
			});

			if (!response.ok) {
				throw new Error("Newsletter signup failed");
			}

			note.textContent =
				"You're on the list — we'll email you at launch.";
			note.className = "mt-4 text-xs font-semibold text-teal-bright";

			form.reset();
			audienceField.value = "guest";

			tabs.forEach((tab) => {
				const active = tab.dataset.audience === "guest";

				tab.classList.toggle("tab-active", active);
				tab.classList.toggle("!text-[#14152A]", active);
				tab.classList.toggle("!text-[#9395AA]", !active);

				tab.setAttribute("aria-selected", String(active));
			});
		} catch {
			note.textContent =
				"Something went wrong. Please try again in a moment.";
			note.className = "mt-4 text-xs font-semibold text-error";
		} finally {
			submitBtn.disabled = false;
		}
	});
</script>
