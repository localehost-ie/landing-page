---
const cards = [
	{
		icon: "id",
		title: "Real people, checked once",
		body: "Government ID plus a live liveness selfie, for every host and every guest. Handled by a dedicated identity provider. We never store your ID ourselves.",
	},
	{
		icon: "video",
		title: "Rooms you can actually trust",
		body: "Hosts confirm their listing with a short live video walkthrough, cross-checked against the address. What you see is what's there.",
	},
	{
		icon: "star",
		title: "Reviews that can't be games",
		body: "Both sides write a review after the stay. Neither is shown until both are in, so nobody's rating is written to placate the other.",
	},
];
---

<section class="border-y border-base-300 bg-base-100 py-16 md:py-24" id="trust">
	<div class="wrap">
		<h2 class="section-heading">
			Verification that means something, on both sides.
		</h2>

		<div class="mt-12 grid gap-5 md:grid-cols-3">
			{
				cards.map((card) => (
					<article class="card rounded-box border border-base-300 bg-base-200 shadow-none">
						<div class="card-body gap-0 p-6">
							<div class="mb-5 flex h-[42px] w-[42px] items-center justify-center rounded-xl bg-teal-soft text-teal-brand">
								{card.icon === "id" && (
									<svg
										width="22"
										height="22"
										viewBox="0 0 24 24"
										fill="none"
										aria-hidden="true"
									>
										<rect
											x="3"
											y="5"
											width="18"
											height="14"
											rx="2"
											stroke="currentColor"
											stroke-width="1.6"
										/>
										<circle
											cx="9"
											cy="11"
											r="2"
											stroke="currentColor"
											stroke-width="1.6"
										/>
										<path
											d="M6 16c0-1.7 1.3-3 3-3s3 1.3 3 3M14 10h4M14 13h4"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
										/>
									</svg>
								)}

								{card.icon === "video" && (
									<svg
										width="22"
										height="22"
										viewBox="0 0 24 24"
										fill="none"
										aria-hidden="true"
									>
										<rect
											x="3"
											y="6"
											width="13"
											height="12"
											rx="2"
											stroke="currentColor"
											stroke-width="1.6"
										/>
										<path
											d="M16 10.5l5-2.7v8.4l-5-2.7"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linejoin="round"
										/>
									</svg>
								)}

								{card.icon === "star" && (
									<svg
										width="22"
										height="22"
										viewBox="0 0 24 24"
										fill="none"
										aria-hidden="true"
									>
										<path
											d="M12 3.5l2.5 5.4 5.8.6-4.4 4 1.2 5.8-5.1-3-5.1 3 1.2-5.8-4.4-4 5.8-.6L12 3.5z"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linejoin="round"
										/>
									</svg>
								)}
							</div>

							<h3 class="text-base font-semibold">
								{card.title}
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-ink-soft">
								{card.body}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
