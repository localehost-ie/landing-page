---
const cards = [
	{
		icon: "id",
		title: "Real people, checked once",
		body: "Government ID plus a live liveness selfie, for every host and every guest. Handled by a dedicated identity provider. We never store your ID ourselves.",
	},
	{
		icon: "video",
		title: "Rooms you can actually trust",
		body: "Hosts confirm their listing with a short live video walkthrough, cross-checked against the address. What you see is what's there.",
	},
	{
		icon: "star",
		title: "Reviews that can't be games",
		body: "Both sides write a review after the stay. Neither is shown until both are in, so nobody's rating is written to placate the other.",
	},
];
---

<section class="trust" id="trust">
	<div class="wrap">
		<span class="eyebrow">Trust &amp; safety</span>
		<h2>Verification that means something, on both sides.</h2>

		<div class="trust-grid">
			{
				cards.map((card) => (
					<div class="trust-card">
						<div class="trust-icon" aria-hidden="true">
							{card.icon === "id" && (
								<svg
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
								>
									<rect
										x="3"
										y="5"
										width="18"
										height="14"
										rx="2"
										stroke="currentColor"
										stroke-width="1.6"
									/>
									<circle
										cx="9"
										cy="11"
										r="2"
										stroke="currentColor"
										stroke-width="1.6"
									/>
									<path
										d="M6 16c0-1.7 1.3-3 3-3s3 1.3 3 3"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linecap="round"
									/>
									<path
										d="M14 10h4M14 13h4"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linecap="round"
									/>
								</svg>
							)}
							{card.icon === "video" && (
								<svg
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
								>
									<rect
										x="3"
										y="6"
										width="13"
										height="12"
										rx="2"
										stroke="currentColor"
										stroke-width="1.6"
									/>
									<path
										d="M16 10.5l5-2.7v8.4l-5-2.7"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linejoin="round"
									/>
								</svg>
							)}
							{card.icon === "star" && (
								<svg
									width="22"
									height="22"
									viewBox="0 0 24 24"
									fill="none"
								>
									<path
										d="M12 3.5l2.5 5.4 5.8.6-4.4 4 1.2 5.8-5.1-3-5.1 3 1.2-5.8-4.4-4 5.8-.6L12 3.5z"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linejoin="round"
									/>
								</svg>
							)}
						</div>
						<h3>{card.title}</h3>
						<p>{card.body}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.trust {
		padding-block: 96px;
		background: var(--paper-raised);
		border-block: 1px solid var(--line);
	}

	.trust h2 {
		font-size: clamp(26px, 3.4vw, 36px);
		max-width: 560px;
		margin-top: 14px;
		font-weight: 600;
	}

	.trust-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 22px;
		margin-top: 48px;
	}

	.trust-card {
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		padding: 26px 24px 28px;
		background: var(--paper);
	}

	.trust-icon {
		width: 42px;
		height: 42px;
		border-radius: 10px;
		background: var(--teal-soft);
		color: var(--teal);
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 18px;
	}

	.trust-card h3 {
		font-size: 16.5px;
		font-weight: 600;
		margin-bottom: 9px;
	}

	.trust-card p {
		font-size: 14px;
		color: var(--ink-soft);
	}

	@media (max-width: 860px) {
		.trust-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
