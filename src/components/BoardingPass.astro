---

---

<div
	class="pass relative grid w-full max-w-[480px] grid-cols-[1fr_96px] overflow-hidden rounded-[22px] bg-base-100 shadow-2xl"
	role="img"
	aria-label="Example LocaleHost booking, showing the check-in window opening seven days before arrival, with the deposit held and not yet charged."
>
	<div class="flex flex-col gap-[18px] p-6">
		<div class="flex items-center justify-between">
			<span class="font-mono text-xs tracking-widest text-ink-faint">
				LOCALEHOST
			</span>
			<span
				class="badge badge-outline badge-success gap-2 font-mono text-[11px]"
			>
				<span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>
				Your booking
			</span>
		</div>

		<div>
			<span
				class="block font-mono text-[10px] uppercase tracking-widest text-ink-faint"
			>
				Room
			</span>
			<h3 class="mt-1 text-xl">Double room · Rathmines, Dublin</h3>
		</div>

		<div
			class="grid grid-cols-2 gap-x-5 gap-y-4 border-t border-dashed border-base-300 pt-4"
		>
			<div>
				<span
					class="block font-mono text-[10px] uppercase tracking-widest text-ink-faint"
					>Guest</span
				>
				<span class="text-sm font-semibold">A. Byrne</span>
			</div>
			<div>
				<span
					class="block font-mono text-[10px] uppercase tracking-widest text-ink-faint"
					>Host</span
				>
				<span class="text-sm font-semibold">S. Ó Conaill</span>
			</div>
			<div>
				<span
					class="block font-mono text-[10px] uppercase tracking-widest text-ink-faint"
					>Move in</span
				>
				<span class="text-sm font-semibold">14 Aug</span>
			</div>
			<div>
				<span
					class="block font-mono text-[10px] uppercase tracking-widest text-ink-faint"
					>Move out</span
				>
				<span class="text-sm font-semibold">28 Nov</span>
			</div>
		</div>

		<div class="pt-1">
			<progress
				class="progress progress-primary h-1.5 w-full"
				value="42"
				max="100"></progress>
			<div
				class="mt-2 flex justify-between font-mono text-[9px] text-ink-faint"
			>
				<span>Booked</span>
				<span>Reconfirm window</span>
				<span>Move in</span>
			</div>
		</div>
	</div>

	<div
		class="flex flex-col items-center justify-center gap-3 bg-neutral px-3 py-5"
	>
		<div class="barcode w-full"></div>
		<span
			class="font-mono text-[10px] tracking-widest text-neutral-content [writing-mode:vertical-rl]"
		>
			DUB · 8842 KX
		</span>
	</div>

	<span class="notch absolute -right-3 -top-3"></span>
	<span class="notch absolute -right-3 -bottom-3"></span>
</div>

<style>
	.pass {
		box-shadow:
			inset 0 0 0 1px #e1e3ec,
			0 24px 60px -24px rgba(20, 21, 42, 0.35);
		transform: rotate(-1.2deg);
	}

	.barcode {
		height: 90px;
		background-image: repeating-linear-gradient(
			90deg,
			#f6f7fa 0px,
			#f6f7fa 2px,
			transparent 2px,
			transparent 5px,
			#f6f7fa 5px,
			#f6f7fa 6px,
			transparent 6px,
			transparent 10px
		);
	}

	.notch {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: #f6f7fa;
		box-shadow: inset 0 0 0 1px #e1e3ec;
	}

	@media (max-width: 560px) {
		.pass {
			transform: none;
		}
	}
</style>
