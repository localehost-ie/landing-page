---
const rows = [
	{
		typical: "Fee is captured the moment a host accepts your request.",
		local: "Fee is held until the check-in window opens. Captured only once you both reconfirm.",
	},
	{
		typical:
			"Host cancels last minute, you're left covering the gap yourself.",
		local: "Host-side cancellation refunds automatically. No ticket, no waiting.",
	},
	{
		typical:
			"Support runs through a single inbox, answered in a day or two.",
		local: "Email and WhatsApp, tied to your booking. No re-explaining the situation.",
	},
];
---

<section class="border-y border-base-300 bg-base-100 py-16 md:py-[88px]">
	<div class="wrap">
		<h2 class="section-heading">
			Most of what goes wrong isn't the room. It's the money.
		</h2>

		<div class="mt-11 overflow-hidden rounded-box border border-base-300">
			<div
				class="grid grid-cols-2 bg-base-200 text-xs uppercase tracking-widest text-ink-faint max-sm:grid-cols-1"
			>
				<div class="p-4 sm:px-6">Typical platforms</div>
				<div class="bg-teal-soft p-4 text-teal-brand sm:px-6">
					LocaleHost
				</div>
			</div>

			{
				rows.map((row) => (
					<div class="grid grid-cols-2 border-t border-base-300 max-sm:grid-cols-1">
						<div class="flex items-start gap-3 p-5 text-sm text-ink-soft sm:px-6">
							<span class="mt-0.5 flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-full bg-error/10 text-[11px] text-error">
								✕
							</span>
							{row.typical}
						</div>
						<div class="flex items-start gap-3 bg-teal-soft p-5 text-sm font-medium text-ink sm:px-6">
							<span class="mt-0.5 flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-full bg-secondary text-[11px] text-white">
								✓
							</span>
							{row.local}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
