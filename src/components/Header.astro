---

---

<header class="site-header">
	<div class="wrap header-inner">
		<a href="/" class="logo" aria-label="LocaleHost home">
			<svg
				width="26"
				height="26"
				viewBox="0 0 32 32"
				fill="none"
				aria-hidden="true"
			>
				<rect width="32" height="32" rx="8" fill="var(--ink)"></rect>
				<path
					d="M8 17.5L16 10l8 7.5"
					stroke="var(--teal-bright)"
					stroke-width="2.4"
					fill="none"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
				<path
					d="M11 16v7h10v-7"
					stroke="var(--paper)"
					stroke-width="2.4"
					fill="none"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
			<span>LocaleHost</span>
		</a>

		<nav class="nav-links" aria-label="Primary">
			<a href="#how-it-works">How it works</a>
			<a href="#trust">Trust &amp; safety</a>
			<a href="#pricing">Pricing</a>
		</nav>

		<div class="header-ctas">
			<a href="#newsletter" class="btn btn-ghost header-cta-ghost"
				>I'm a host</a
			>
			<a href="#newsletter" class="btn btn-primary header-cta-primary"
				>Find a room</a
			>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(246, 247, 250, 0.86);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding-block: 16px;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		text-decoration: none;
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 19px;
		letter-spacing: -0.01em;
	}

	.nav-links {
		display: flex;
		gap: 30px;
		font-size: 14.5px;
		font-weight: 500;
		color: var(--ink-soft);
	}

	.nav-links a {
		text-decoration: none;
	}

	.nav-links a:hover {
		color: var(--ink);
	}

	.header-ctas {
		display: flex;
		gap: 10px;
		flex-shrink: 0;
	}

	.header-cta-ghost,
	.header-cta-primary {
		padding: 9px 16px;
		font-size: 13.5px;
	}

	@media (max-width: 780px) {
		.nav-links {
			display: none;
		}
		.header-cta-ghost {
			display: none;
		}
	}

	@media (max-width: 460px) {
		.header-cta-primary {
			padding: 9px 13px;
		}
	}
</style>
