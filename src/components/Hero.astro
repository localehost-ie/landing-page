---
import BoardingPass from "./BoardingPass.astro";
---

<section class="hero" id="top">
	<div class="wrap hero-inner">
		<div class="hero-copy">
			<span class="eyebrow">Room-sharing and homestays</span>
			<h1>
				Your fee shouldn't be<br />
				at risk before your <span class="highlight">stay</span> is.
			</h1>
			<p class="hero-sub">
				LocaleHost matches verified hosts with verified guests, then
				holds the fee until check-in opens, about a week out. Nobody
				pays for a room that falls through.
			</p>

			<div class="hero-ctas">
				<a href="#newsletter" class="btn btn-primary"
					>Get early access</a
				>
				<a href="#how-it-works" class="btn btn-ghost"
					>See how it works</a
				>
			</div>

			<div class="hero-trust-row">
				<span
					><strong>ID + selfie</strong> verification for guests and hosts</span
				>
				<span class="sep">·</span>
				<span><strong>2-week</strong> cancellation window</span>
				<span class="sep">·</span>
			</div>
		</div>

		<div class="hero-visual">
			<BoardingPass />
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: 76px 40px;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		align-items: center;
		gap: 56px;
	}

	.hero-copy h1 {
		font-size: clamp(34px, 4.6vw, 54px);
		margin-top: 16px;
		font-weight: 600;
	}

	.highlight {
		color: var(--indigo-bright);
	}

	.hero-sub {
		margin-top: 22px;
		font-size: 17.5px;
		color: var(--ink-soft);
		max-width: 480px;
	}

	.hero-ctas {
		display: flex;
		gap: 12px;
		margin-top: 32px;
		flex-wrap: wrap;
	}

	.hero-trust-row {
		margin-top: 28px;
		font-size: 13.5px;
		color: var(--ink-faint);
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}

	.hero-trust-row strong {
		color: var(--ink-soft);
		font-weight: 600;
	}

	.sep {
		color: var(--line);
	}

	.hero-visual {
		display: flex;
		justify-content: center;
	}

	@media (max-width: 900px) {
		.hero-inner {
			grid-template-columns: 1fr;
			gap: 48px;
		}
		.hero-visual {
			order: -1;
		}
		.hero-sub {
			max-width: none;
		}
	}
</style>
