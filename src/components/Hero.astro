---
import BoardingPass from "./BoardingPass.astro";
---

<section class="py-16 md:pb-10 md:pt-20" id="top">
	<div
		class="wrap grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-14"
	>
		<div>

			<h1
				class="mt-4 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl lg:text-[54px]"
			>
				Your fee shouldn't be<br class="hidden sm:block" />
				at risk before your <span class="text-indigo-bright">stay</span> is.
			</h1>

			<p class="mt-6 max-w-[480px] text-lg text-ink-soft">
				LocaleHost matches verified hosts with verified guests, then
				holds the fee until check-in opens, about a week out. Nobody
				pays for a room that falls through.
			</p>

			<div class="mt-8 flex flex-wrap gap-3">
				<a href="#newsletter" class="btn btn-neutral">
					Get early access
				</a>
				<a href="#how-it-works" class="btn btn-outline">
					See how it works
				</a>
			</div>

			<div
				class="mt-7 flex flex-wrap items-center gap-2 text-sm text-ink-faint"
			>
				<span
					><strong class="text-ink-soft">ID + selfie</strong> verification
					for guests and hosts</span
				>
				<span class="text-base-300">·</span>
				<span
					><strong class="text-ink-soft">2-week</strong> cancellation window</span
				>
			</div>
		</div>

		<div class="flex justify-center lg:justify-end">
			<BoardingPass />
		</div>
	</div>
</section>
