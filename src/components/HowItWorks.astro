---
const steps = [
	{
		n: "01",
		title: "Verify once",
		body: "ID and a live selfie for guests. Takes a few minutes, done once.",
	},
	{
		n: "02",
		title: "Book, even a few in parallel",
		body: "Request as many rooms as you like. Each host can confirm independently. If a host says yes to one it doesn't cancel the others. You choose which to keep.",
	},
	{
		n: "03",
		title: "Fee is held, not charged",
		body: "Once you accept a room, the fee is authorized but sits untouched. Nothing is captured yet.",
	},
	{
		n: "04",
		title: "Check-in window opens",
		body: "About a week before move-in, both sides reconfirm. Fee captures only once you both do. If the host can't follow through, you're refunded automatically.",
	},
	{
		n: "05",
		title: "Move in",
		body: "WiFi details and house info land in your inbox. You've both already confirmed everything still holds.",
	},
];
---

<section class="section-space" id="how-it-works">
	<div class="wrap">
		<h2 class="section-heading">
			Five steps, most of them before money moves.
		</h2>

		<ol class="mt-12 max-w-2xl">
			{
				steps.map((step, i) => (
					<li class="flex gap-6">
						<div class="flex shrink-0 flex-col items-center">
							<span class="flex h-[34px] w-[34px] items-center justify-center rounded-full bg-primary text-xs font-medium text-primary-content">
								{step.n}
							</span>
							{i !== steps.length - 1 && (
								<span class="my-1 min-h-10 w-px flex-1 bg-base-300" />
							)}
						</div>

						<div class="pb-9">
							<h3 class="text-lg font-semibold">{step.title}</h3>
							<p class="mt-2 max-w-[480px] text-sm text-ink-soft">
								{step.body}
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
