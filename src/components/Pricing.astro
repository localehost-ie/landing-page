---
const tiers = [
	{
		label: "Verified Irish residents",
		price: "€200",
		note: "One-time fee, held until check-in opens",
		perks: [
			"PPS-verified residency",
			"Faster reference checks",
			"Priority matching",
		],
		featured: true,
	},
	{
		label: "International guests",
		price: "€350-400",
		note: "One-time fee, held until check-in opens",
		perks: [
			"Full ID + selfie verification",
			"Relocation support",
			"Same refund guarantees",
		],
		featured: false,
	},
];
---

<section class="section-space" id="pricing">
	<div class="wrap">
		<h2 class="section-heading">
			One fee. Held, not spent. No surprises on page three.
		</h2>

		<p class="mt-4 max-w-xl text-[15px] text-ink-soft">
			Hosts set their own rent — we don't cap it. Our fee is priced by
			verified residency, not nationality, because that's what actually
			changes the work on our side.
		</p>

		<div class="mt-11 grid gap-6 md:grid-cols-2">
			{
				tiers.map((tier) => (
					<article
						class:list={[
							"card relative rounded-box border bg-base-100 shadow-none",
							tier.featured
								? "border-primary shadow-xl shadow-primary/10"
								: "border-base-300",
						]}
					>
						{tier.featured && (
							<div class="absolute -top-3 left-7">
								<span class="badge badge-primary text-[10px] uppercase tracking-wider">
									Most common
								</span>
							</div>
						)}

						<div class="card-body p-7">
							<span class="text-sm font-medium text-ink-soft">
								{tier.label}
							</span>

							<span class="mt-2 text-4xl font-medium">
								{tier.price}
							</span>

							<span class="text-sm text-ink-faint">
								{tier.note}
							</span>

							<div class="my-3 border-t border-dashed border-base-300" />

							<ul class="flex flex-col gap-3">
								{tier.perks.map((perk) => (
									<li class="flex items-center gap-3 text-sm">
										<span class="flex h-[18px] w-[18px] shrink-0 items-center justify-center rounded-full bg-teal-soft text-[10px] text-teal-brand">
											✓
										</span>
										{perk}
									</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</div>

		<p class="mt-7 text-sm text-ink-faint">
			For comparison: fees on typical Irish room-share platforms currently
			run €450-600+, captured the moment a host accepts.
		</p>
	</div>
</section>
