---
const year = new Date().getFullYear();
---

<footer class="bg-neutral pt-16 text-neutral-content">
	<div class="wrap">
		<div
			class="footer footer-vertical gap-10 border-b border-white/10 pb-12 sm:footer-horizontal sm:justify-between"
		>
			<aside class="max-w-xs">
				<span
					class="flex items-center gap-2 font-display text-lg font-semibold text-base-100"
				>
					LocaleHost
				</span>
				<p class="mt-3 text-sm text-base-300">
					Fair, verified room-sharing for Ireland.
				</p>
			</aside>

			<nav class="flex flex-col gap-3">
				<h6
					class="text-xs uppercase tracking-widest text-base-300"
				>
					Platform
				</h6>
				<a
					href="https://app.localehost.ie"
					class="link link-hover text-sm">app.localehost.ie</a
				>
				<span class="text-xs text-base-300">Launching soon</span>
			</nav>

			<nav class="flex flex-col gap-3">
				<h6
					class="text-xs uppercase tracking-widest text-base-300"
				>
					Get in touch
				</h6>
			</nav>
		</div>

		<div class="py-6 text-xs text-base-300">
			© {year} LocaleHost
		</div>
	</div>
</footer>
