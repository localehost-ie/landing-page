---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = "LocaleHost > Fair, verified room-sharing in Ireland",
	description = "LocaleHost is a room-rental platform for Ireland built around one idea: nobody's money should be on the line until both sides have confirmed the stay. Verified hosts, verified guests, fees that make sense.",
	noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="localehost">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />

		{noindex && <meta name="robots" content="noindex, nofollow" />}
	</head>
	<body>
		<slot />
	</body>
</html>
