---
interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const {
	title = "LocaleHost > Fair, verified room-sharing in Ireland",
	description = "LocaleHost is a room-rental platform for Ireland built around one idea: nobody's money should be on the line until both sides have confirmed the stay. Verified hosts, verified guests, fees that make sense.",
	noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		<style is:global>
			@import "../styles/global.css";
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>
